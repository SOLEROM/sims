# local.env.example — copy to orch/v1/local.env (UNTRACKED, gitignored) for
# per-STATION knobs only. Sourced LAST by simrun.sh, so it overrides env.list
# and profile defaults. Machine config lives here; sim config lives in env.list.

# FlightGear render backend for THIS station (see fgear readme render lessons):
#   intel|host  hybrid laptop whose Xorg runs on the iGPU — fast + correct
#   1|auto      NVIDIA passthrough only if a real nvidia docker runtime exists
#   0|sw        llvmpipe last resort (slow, no ortho ground)
#FGFS_GPU=intel

# ground-station launch for @once:qgc tabs (px4-fg profile)
#QGC_CMD=~/QGroundControl-x86_64.AppImage
