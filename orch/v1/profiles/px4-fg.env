# px4-fg profile defaults: host-network single-vehicle profile — no anchors
SIM_NO_ANCHOR=1
# gz GUI window: PX4's rcS (px4-rc.gzsim) spawns `gz sim -g` when HEADLESS is
# unset in its env — and the frozen image gets DISPLAY, so a Gazebo window
# pops. Default 1 = physics server only (reference behavior; QGC is the eyes).
# Set PX4_HEADLESS=0 (local.env or explicit env) to get the GUI window back.
# Design note: design/px4-fg-gazebo-headless.md
PX4_HEADLESS="${PX4_HEADLESS:-1}"

# FlightGear side of THIS profile. The frozen px4 world (default.sdf) puts the
# vehicle at Zurich Irchel (47.397971, 8.546164, ground 0 m AMSL); the pose tap
# teleports the FG camera there — 9000+ km from env.list's KSFO home and from
# FG's only stock scenery — so without a local ground the renderer draws void.
# Align FG's init home + the runtime ortho satellite ground with the px4 world.
# The ortho assets are generated per station (untracked; ~1 min, needs net):
#   FG_HOME_LAT=47.397971 FG_HOME_LON=8.546164 \
#     ./fgear/craft_base_24/tools/gen_orthophotos.sh --assets fgear/craft_base_24/assets
FG_HOME_LAT=47.397971
FG_HOME_LON=8.546164
FG_HOME_ALT=3
# quad elevation rule (fgear readme render lessons): above FG's no-scenery
# sea-level ground (0 m), below the landed nadir camera (~0.4 m AMSL here).
# Explicit because the runner's HOME_ALT-derived default mixes ft/m.
FG_ORTHO_ELEV_M=0.2
FG_ASSETS_DIR=./fgear/craft_base_24/assets
