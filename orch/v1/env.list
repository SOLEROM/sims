# env.list — tracked, sim-wide shared environment (sourced first by simrun.sh;
# profile .env then local.env may override). Keep STATION-specific knobs out of
# here — those belong in the untracked local.env (see local.env.example).

# home / base position (fgear reads FG_HOME_*; PX4-style PX4_HOME_* also works)
FG_HOME_LAT=37.613544
FG_HOME_LON=-122.357172
FG_HOME_ALT=5

# camera defaults (square window on purpose — see fgear readme render lessons)
FG_CAM_WIDTH=800
FG_CAM_HEIGHT=800
FG_FOV=55
