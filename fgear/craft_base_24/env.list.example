# env.list.example — every knob of the craft_base_24 FlightGear layer, with its
# default. Copy what you need into your project's tracked env file and pass it
# via FG_ENV_FILE (or export in the shell / a station-local untracked local.env).
# Precedence: explicit env > env file > built-in default.
#
# The layer also accepts PX4_HOME_LAT/LON/ALT wherever FG_HOME_* is read, so a
# PX4-style env file drops in unchanged.

## ---- mode + identity -------------------------------------------------------
#FG_MODE=standalone            # standalone | external-fdm (drone-camera renderer)
#ID=                           # instance id: container fgfs_$ID, title FlightGear-$ID,
                               # NavCache volume fgfs_home_$ID
#FG_IMAGE=fgfs-base:24
#FG_WINDOW_TITLE=              # default FlightGear[-$ID]

## ---- home / base position (renderer starts here) ---------------------------
#FG_HOME_LAT=37.613544
#FG_HOME_LON=-122.357172
#FG_HOME_ALT=5                 # meters AMSL

## ---- camera / window (external-fdm) ----------------------------------------
#FG_CAM_WIDTH=800              # SQUARE default on purpose: a landscape window +
#FG_CAM_HEIGHT=800             # wide FOV pushes an oblique ground wedge into frame
#FG_GEOMETRY=                  # overrides WxH if set
#FG_FOV=55
#FG_AIRCRAFT=ufo               # any installed aircraft; ufo ships with base fgdata
#FG_TIMEOFDAY=noon
#FG_WEATHER=Fair weather
#FG_METAR=XXXX 012000Z 00000KT 9999 CLR 22/19 Q1013 NOSIG

## ---- pose input + control ports (external-fdm; identical across instances —
## isolation is by network namespace, never by renumbering) -------------------
#FG_GENERIC_PORT=15778         # UDP in: 9-field fg_protocol pose (feed_fdm.py)
#FG_GENERIC_HZ=40
#FG_PROTOCOL=fg_protocol
#FG_TELNET_PORT=15777          # props telnet (fg_prop.py — scripted verification)
#FG_FDM_PORT=5503              # native-fdm UDP in (legacy-compat, usually unused)

## ---- ortho satellite ground (external-fdm; see readme render lessons) ------
#FG_ORTHO_AUTO=                # default: 1 iff the model exists in the FG tree
#FG_ORTHO_PATH=Models/proj/ortho_home.xml
#FG_ORTHO_LAT=                 # default: home
#FG_ORTHO_LON=
#FG_ORTHO_ELEV_M=              # absolute AMSL; default home_alt - FG_ORTHO_BELOW_CAM_M
#FG_ORTHO_BELOW_CAM_M=1.0      # plane sits this far below the landed camera
#FG_ORTHO_ELEV_OFFSET_M=1.5    # terrain+offset fallback when elev unset/-9999

## ---- rendering backend + quality -------------------------------------------
#FGFS_GPU=1                    # intel|host (host-X hardware GL) | 1/auto | 0/sw
                               # (sw = llvmpipe: SLOW and the ortho ground does
                               #  NOT render — never use it to "fix" a GPU box)
#FG_PHOTOSCENERY=false         # terrain photoscenery .dds path (teal on some builds)
#FG_SHADER_EFFECTS=false
#FG_GL_COMPAT=1                # OSG/Mesa compat exports (needed for llvmpipe/Xvfb)

## ---- host-side wiring (run.sh) ----------------------------------------------
#FG_NET=                       # ""=bridge | host | container:<netns-owner>
                               # external-fdm defaults to host when unset
#FG_ASSETS_DIR=                # project dir: Orthophotos/ Models/ Objects/ Nasal/
                               # Protocol/ AI/ (see run.sh header for mapping)
#FG_ENV_FILE=                  # --env-file passed to docker
#FG_HOME_VOL=                  # NavCache volume; "" disables persistence
#AI_SCENARIO=                  # optional FG AI scenario name

## ---- validation / CI --------------------------------------------------------
#FG_DRYRUN=0                   # print assembled fgfs command, don't launch
#FG_DOCKER_DRYRUN=0            # print assembled docker command, don't run
#FG_HEADLESS=0                 # xvfb + software GL (no display needed)
#FG_EXTRA_ARGS=                # extra fgfs args (word-split)
